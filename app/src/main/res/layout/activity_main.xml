<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="40dp"
        android:paddingEnd="64dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/application_heading"
            style="@style/NannyCamHeading"
            android:text="@string/app_name" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="20dp"
            android:background="@color/surface"
            android:focusable="false"
            app:keep_content_on_player_reset="false"
            app:show_buffering="never"
            app:use_controller="false" />

        <TextView
            android:id="@+id/decoder_text"
            style="@style/NannyCamMessage"
            android:layout_marginTop="8dp"
            android:text="@string/selected_decoder_unknown" />

        <TextView
            style="@style/NannyCamSectionHeading"
            android:layout_marginTop="32dp"
            android:text="@string/camera_configuration" />

        <TextView
            style="@style/NannyCamLabel"
            android:layout_marginTop="16dp"
            android:text="@string/camera_endpoint_label" />

        <EditText
            android:id="@+id/endpoint_input"
            style="@style/NannyCamInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/camera_endpoint_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_button"
                style="@style/NannyCamButton"
                android:text="@string/save" />

            <Button
                android:id="@+id/connect_button"
                style="@style/NannyCamButton"
                android:layout_marginStart="16dp"
                android:enabled="false"
                android:text="@string/connect" />

            <Button
                android:id="@+id/disconnect_button"
                style="@style/NannyCamButton"
                android:layout_marginStart="16dp"
                android:enabled="false"
                android:text="@string/disconnect" />
        </LinearLayout>

        <TextView
            android:id="@+id/configuration_message"
            style="@style/NannyCamMessage"
            android:layout_marginTop="12dp" />

        <TextView
            style="@style/NannyCamSectionHeading"
            android:layout_marginTop="28dp"
            android:text="@string/status" />

        <TextView
            android:id="@+id/status_text"
            style="@style/NannyCamStatus"
            android:text="@string/not_connected" />

        <Button
            android:id="@+id/video_buffering_button"
            style="@style/NannyCamButton"
            android:layout_marginTop="12dp"
            android:text="@string/video_buffering_low_latency" />

        <TextView
            style="@style/NannyCamSectionHeading"
            android:layout_marginTop="28dp"
            android:text="@string/audio" />

        <TextView
            android:id="@+id/audio_state_text"
            style="@style/NannyCamStatus"
            android:text="@string/audio_stopped" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mute_button"
                style="@style/NannyCamButton"
                android:enabled="false"
                android:text="@string/mute" />

            <Button
                android:id="@+id/processing_button"
                style="@style/NannyCamButton"
                android:layout_marginStart="16dp"
                android:enabled="false"
                android:text="@string/processed_pcm" />
        </LinearLayout>

        <TextView
            android:id="@+id/audio_diagnostics_text"
            style="@style/NannyCamDiagnostics"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:textIsSelectable="false" />

        <TextView
            style="@style/NannyCamSectionHeading"
            android:layout_marginTop="28dp"
            android:text="@string/runtime_diagnostics" />

        <Button
            android:id="@+id/h264_probe_button"
            style="@style/NannyCamButton"
            android:layout_marginTop="12dp"
            android:text="@string/probe_h264_video" />

        <TextView
            android:id="@+id/diagnostics_text"
            style="@style/NannyCamDiagnostics"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:textIsSelectable="false" />
    </LinearLayout>
</ScrollView>
